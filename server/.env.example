# ==============================================================================
# CASTREACH — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# NEVER COMMIT ACTUAL SECRETS OR REAL CREDENTIALS TO GIT OR SOURCED CONTROLS
# ==============================================================================

# ── 1. BOOT-CRITICAL REQUIRED VARIABLES ─────────────────────────────────────────
# The Node.js server process will fail validation and refuse to boot if missing.
NODE_ENV=production
PORT=3001
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/castreach?retryWrites=true&w=majority
JWT_SECRET=replace_with_at_least_64_character_cryptographically_secure_random_string
JWT_REFRESH_SECRET=replace_with_another_64_character_cryptographically_secure_random_string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CLIENT_URL=https://app.castreach.com
PLATFORM_FEE_BPS=1500

# ── 2. WEBSOCKET & REALTIME CONFIGURATION ──────────────────────────────────────
# Required for native WebSocket server connectivity and CORS handshake.
WS_URL=wss://api.castreach.com/ws

# ── 3. FEATURE-SCOPED EXTERNAL SERVICE VARIABLES (OPTIONAL AT BOOT) ─────────────
# Enforced per-route (returns HTTP 503 if missing when feature endpoint is called).

# Stripe Escrow & Payments (Phase D1/D2)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Daily.co WebRTC Secure Meeting Rooms & Cloud Recordings (Phase C1/C2)
DAILY_API_KEY=your_production_daily_api_key
DAILY_WEBHOOK_SECRET=your_production_daily_webhook_secret

# Anthropic Claude AI Podcast Intelligence & Show Notes Engine (Phase E3)
ANTHROPIC_API_KEY=sk-ant-api03-...

# ── 4. OBJECT STORAGE & S3/R2 PERSISTENT MEDIA ABSTRACTION ────────────────────
# Required for permanent recording storage, EDL output, transcripts, and avatars.
STORAGE_PROVIDER=s3
STORAGE_BUCKET=castreach-production-media
AWS_ACCESS_KEY_ID=your_aws_or_r2_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_or_r2_secret_access_key
AWS_REGION=us-east-1

# Optional fallback: Supabase Storage integration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# ── 5. WORKER-SPECIFIC CONFIGURATION ──────────────────────────────────────────
# Used by background workers (renderWorker, transcriptionWorker, aiWorker).
FFMPEG_PATH=ffmpeg
TRANSCRIPTION_PROVIDER=whisper

# ── 6. DEVELOPMENT & LOCAL TESTING ONLY (DO NOT USE IN PRODUCTION) ───────────
# MONGODB_URI=memory               # FORBIDDEN in production (validated by validateEnv.js)
# JWT_SECRET=default_secret        # FORBIDDEN in production (validated by validateEnv.js)
